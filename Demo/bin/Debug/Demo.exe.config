<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>
		<add name="DefaultConnection"
             connectionString="Data Source=ADCLG1;Initial Catalog=Demo_Kruzhkov;Integrated Security=True;Encrypt=False"
             providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="CompanyName" value="Чистая Планета" />
		<add key="AppVersion" value="1.0.0" />
	</appSettings>
</configuration>
